# ===== Bluesky 認証情報（必須） =====
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ===== Anthropic API 認証情報（必須） =====
# https://console.anthropic.com/ で API キーを発行
ANTHROPIC_API_KEY=

# ===== 医療ニュース RSS フィード一覧 =====
# カンマ区切りで複数指定。
# デフォルト: NEJM + BMJ + The Lancet + Nature Medicine + WHO + Science Daily + STAT News + MedPage Today + CBニュース
MED_FEED_URLS=https://www.nejm.org/action/showFeed?jc=nejm&type=etoc&feed=rss,https://www.bmj.com/rss/recent,https://www.thelancet.com/rssfeed/lancet_online.xml,https://www.nature.com/nm.rss,https://www.who.int/feeds/entity/news/en/rss.xml,https://www.sciencedaily.com/rss/health_medicine.xml,https://www.statnews.com/feed/,https://www.medpagetoday.com/rss/headlines.xml,https://www.cbnews.jp/news/rss.xml

# ===== 翻訳設定（任意） =====
TRANSLATION_MODEL=claude-haiku-4-5-20251001

# ===== 投稿設定（任意） =====
# 1 回の実行あたりの最大投稿件数
MAX_POSTS_PER_RUN=1

# 投稿済み URL の保存先
POSTED_URLS_FILE=data/posted_urls.json

# 投稿済み URL の保持上限件数。これを超えると古いものから自動削除される
MAX_STORED_URLS=1000

# 投稿間隔（ミリ秒）。1 件運用なら不要
POST_INTERVAL_MS=3000

# ===== キーワードフィルタ =====
# true なら全件を投稿候補にする (デフォルト: false でホワイトリストフィルタ有効)
DISABLE_KEYWORD_FILTER=

# ===== プロフィール (npm run setup:profile で使用) =====
# Bot アカウントの bio に設定する文章 (最大 256 グラフェム)。
# BOT_DESCRIPTION="医療・医学の最新ニュースを国内外から自動収集。英語記事は Claude で日本語訳。毎時 1 件、JST 9-23 時。\n\n🤖 Bot | 📰 全投稿に元記事リンク\n⚙️ src: github.com/httttmm/med-news-bot\n\n#医療 #医学"

# ===== デバッグ =====
DEBUG=
